# Backend
DATABASE_URL=postgresql+psycopg://eduassist:eduassist@localhost:5432/eduassist
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRE_MINUTES=480

# Model — free local default, optional free Groq fallback
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=2048
# GROQ_API_KEY=

# Embeddings and vectors
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=backend/data/chroma

# Uploads
UPLOAD_DIR=backend/data/uploads
MAX_UPLOAD_MB=25

# Retrieval and mastery thresholds
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.30
WEAK_THRESHOLD=40
STRONG_THRESHOLD=75
